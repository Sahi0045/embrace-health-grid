{
  "name": "embrace-health-grid",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"vite dev\" \"npm run dev --prefix admin-portal\"",
    "build": "NODE_ENV=production vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"admin-portal/src/**/*.{ts,tsx}\"",
    "test:backend": "npm --prefix backend test",
    "test:backend:api": "npm --prefix backend run test:api",
    "test": "npm run test:backend"
  },
