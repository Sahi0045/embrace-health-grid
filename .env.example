# Embrace Health Grid — Environment Variables
# Copy this file to .env and fill in the values

# ─── Backend ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_KEY=change-me-client-auth-secret
IDENTITY_SECRET=change-me-identity-hmac-secret
PORT=3001

# First-admin bootstrap protection key (optional but recommended in production).
# POST /api/auth/setup will require this value in the request body as "setupKey".
# Once an admin exists, the setup endpoint returns 410 Gone regardless of this key.
SETUP_KEY=change-me-setup-key-min-16-chars

# ─── HIPAA Encryption (§ 164.312(a)(2)(iv)) ───────────────────────────────────
# PHI Encryption Key — AES-256-GCM key for encrypting PHI at rest.
# MUST be exactly 64 hex characters (32 bytes). REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=change-me-64-hex-chars-exactly-0000000000000000000000000000000

# Audit Log HMAC Key — used to sign audit log entries for tamper detection.
# Any strong random string. Ideally different from JWT_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_HMAC_KEY=change-me-audit-hmac-key-different-from-jwt-secret

# ─── Node environment ──────────────────────────────────────────────────────────
# Do NOT set NODE_ENV in this file for frontend builds.
# NODE_ENV=development at build time makes TanStack Start/Nitro emit jsxDEV,
# which crashes production SSR on Vercel with:
#   TypeError: jsxDevRuntimeExports.jsxDEV is not a function
# Vite/Nitro set NODE_ENV automatically. Backend can set it in its process env.

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# ─── Solana (required — anchoring is real devnet, there is no simulated mode) ──
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_WALLET_SECRET=

# Required when using embedded hospital wallets. This encrypts server-held Solana
# private keys at rest. Never commit or reuse this value; set it in your hosting
# provider's secret manager. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=
# ─── Privileged server key ─────────────────────────────────────────────────────
# Bypasses RLS. Required by getSupabaseServiceRoleClient() for the few reads that
# RLS deliberately denies the request-scoped client — currently only
# embedded_wallets.encrypted_private_key, which is not granted to `authenticated`
# at all. Server-side only: never mirror this into a VITE_* variable, or it ships
# to the browser and every RLS policy in the project becomes advisory.
SUPABASE_SERVICE_ROLE_KEY=


# ─── Frontend ──────────────────────────────────────────────────────────────────
# Legacy base URL for the few shims that still read it. The Express backend is
# decommissioned; data access goes through Supabase and server functions.
VITE_API_BASE_URL=http://localhost:3001

# Set to "true" to hide the seeded demo logins on the sign-in page. These are
# real working credentials, so switch this on before the app holds real PHI.
VITE_HIDE_DEMO_CREDENTIALS=

# ─── Deployment ────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
